# ==============================================================================
# Auralis Autonomous City — Real-World Environment Configuration
# ==============================================================================
# ZERO-FABRICATION POLICY:
# When MOCK_MODE=false, the platform runs strictly on verified real data feeds.
# If an upstream source fails or is unreachable, the system displays an explicit
# "Source Unavailable" state rather than synthesizing placeholder information.
# ==============================================================================

# Core Database Configuration
AURALIS_DB=./auralis.db

# Zero-Fabrication Enforcement (default: false)
# Set to 'true' only if you explicitly want to run simulated sandbox scenarios.
NEXT_PUBLIC_MOCK_MODE=false

# Jurisdiction Coordinates (Default: Vijayawada, AP, India)
AURALIS_JURISDICTION_LAT=16.5062
AURALIS_JURISDICTION_LON=80.6480
AURALIS_JURISDICTION_NAME=Vijayawada

# Real-World Open Meteorological Data (Open-Meteo WMO Stations / ECMWF)
# Enabled by default — uses open-access verified atmospheric telemetry.
ENABLE_REAL_WEATHER_FEED=true

# Real-World OpenStreetMap Physical Infrastructure GIS Connector (Overpass API)
# Queries real mapped municipal waterways, substations, pump houses, and highways.
ENABLE_REAL_OSM_GIS=true

# API & Gateway Configuration
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_PRINCIPAL=p_operator

# Custom AI / LLM Reasoning Engine (Optional)
# Leave unset to run 100% on the deterministic rule-based verification path.
# Set when connecting your own custom LLM inference endpoint.
# CUSTOM_LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
AURALIS_WORKFLOW_TOKEN_BUDGET=40000
AURALIS_WORKFLOW_COST_BUDGET_USD=0.50
