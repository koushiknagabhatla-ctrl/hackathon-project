# ==============================================================================
# Auralis Autonomous City — Real-World Environment Configuration
# ==============================================================================
# ZERO-FABRICATION POLICY:
# When MOCK_MODE=false, the platform runs strictly on verified real data feeds.
# If an upstream source fails or is unreachable, the system displays an explicit
# "Source Unavailable" state rather than synthesizing placeholder information.
# ==============================================================================

# Core Database Configuration
AURALIS_DB=./auralis.db

# Zero-Fabrication Enforcement (default: false)
# Server-side gate. When false, NO fabricated world data is loaded: no seeded
# incidents, assets, evidence, contacts or devices. Configuration (tenant,
# identities, policy bundle, tool manifests) still loads, because that is setup
# and not an assertion about the world.
# When true, the entire environment is labelled SIMULATION in the UI and
# outbound emergency dispatch is hard-blocked.
MOCK_MODE=false

# Browser-side mirror of the flag above, so the UI can render the banner.
NEXT_PUBLIC_MOCK_MODE=false

# Contacting emergency services is irreversible. Even with valid ERSS
# credentials, nothing transmits unless this is explicitly true.
ALLOW_OUTBOUND_NOTIFICATIONS=false

# Emergency contacts are NEVER seeded. Supply real, consented contacts here as
# JSON, each with a consent_reference pointing at proof the person agreed to be
# contacted. Entries without a consent_reference are rejected.
# AURALIS_EMERGENCY_CONTACTS=[{"id":"cnt_1","name":"...","role":"disaster_officer","phone_e164":"+91...","consent_reference":"consent-record-123"}]

# Emergency Response Support System (ERSS 112) CAD gateway.
# Leave unset unless you hold authorized access. Without these the system
# escalates to manual operator dispatch and never claims a unit was sent.
# ERSS_112_GATEWAY_URL=
# ERSS_112_API_KEY=

# Jurisdiction Coordinates (Default: Vijayawada, AP, India)
AURALIS_JURISDICTION_LAT=16.5062
AURALIS_JURISDICTION_LON=80.6480
AURALIS_JURISDICTION_NAME=Vijayawada

# Real-World Open Meteorological Data (Open-Meteo WMO Stations / ECMWF)
# Enabled by default — uses open-access verified atmospheric telemetry.
ENABLE_REAL_WEATHER_FEED=true

# Real-World OpenStreetMap Physical Infrastructure GIS Connector (Overpass API)
# Queries real mapped municipal waterways, substations, pump houses, and highways.
ENABLE_REAL_OSM_GIS=true

# ------------------------------------------------------------------------------
# CONNECTORS — services/api/connectors/registry.py is the catalogue. Its
# `trust_tier` per source is deliberately conservative; raising one there
# silently raises the precedence its evidence wins in conflict resolution.
# Refresh them all with:  python scripts/poll_connectors.py --once
#
# KEYLESS AND LIVE OUT OF THE BOX (nothing to set):
#   conn_openmeteo        https://api.open-meteo.com/v1/forecast          verified
#   conn_openmeteo_flood  https://flood-api.open-meteo.com/v1/flood       verified
#   conn_usgs_seismic     https://earthquake.usgs.gov/.../all_day.geojson certified
#   conn_osm              https://overpass-api.de/api/interpreter         crowdsourced
# ------------------------------------------------------------------------------

# Where connector fetch-status and response caches are written. These carry the
# ORIGINAL upstream timestamp, so a cache hit can never be rendered as "now".
# AURALIS_CACHE_DIR=./data/cache

# Tenant the connectors attach their `connector` rows to.
# AURALIS_TENANT_ID=ten_vijayawada

# OpenWeatherMap — OPTIONAL second meteorological source. Its job is
# corroboration: when it disagrees with Open-Meteo beyond tolerance both
# readings are kept and an evidence conflict is raised. Values are never
# averaged. Free tier key: https://home.openweathermap.org/api_keys
# Unset => the source reports `unconfigured`, which is a legitimate state.
# OPENWEATHER_API_KEY=

# OpenAQ v3 air quality — free API key required in the X-API-Key header.
# Register: https://explore.openaq.org/register
# OpenAQ is an AGGREGATOR that relays CPCB reference monitors for India; it is
# `verified`, not `statutory`, because we are not reading CPCB directly.
# Unset => the source reports `unconfigured`. It never estimates a reading.
# OPENAQ_API_KEY=

# India-WRIS (National Water Informatics Centre) — NOT INTEGRATED.
# Probed 2026-08-21: indiawris.gov.in and arc.indiawris.gov.in did not complete
# a TCP connection, and no public JSON endpoint for river stage was verified.
# No response shape has been guessed and no parser exists. To enable, obtain an
# NWIC-issued endpoint and credential and implement against their documented
# schema. Contact: https://indiawris.gov.in (National Water Informatics Centre)
# INDIAWRIS_API_URL=
# INDIAWRIS_API_KEY=

# CWC Flood Forecasting System — NOT INTEGRATED.
# Probed 2026-08-21: ffs.india-water.gov.in responds, but its undocumented
# /iam/api surface returned a single Kerala groundwater well with null
# coordinates and no forecast fields. There is no stable public contract to
# parse, so none is assumed. Set these only if CWC grants real access.
# CWC_FFS_API_URL=
# CWC_FFS_API_KEY=

# API & Gateway Configuration
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_PRINCIPAL=p_operator

# Custom AI / LLM Reasoning Engine (Optional)
# Leave unset to run 100% on the deterministic rule-based verification path.
# Set when connecting your own custom LLM inference endpoint.
# CUSTOM_LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
AURALIS_WORKFLOW_TOKEN_BUDGET=40000
AURALIS_WORKFLOW_COST_BUDGET_USD=0.50

# ------------------------------------------------------------------------------
# LLM backend routing — services/api/agents/llm_gateway.py, the ONLY path to a
# model. Comma-separated, tried in order; `deterministic` is always appended as
# the terminal element, so there is no setting in which a request goes
# unanswered. Whichever one answers is reported in the API response and written
# to `agent_run.model_version` — the fallback is never silent.
#   local          the fine-tuned Andhra Pradesh adapter below (no key, no cost,
#                  no data egress). Abstains outside Andhra Pradesh.
#   anthropic      the hosted path; used only when ANTHROPIC_API_KEY is set.
#   deterministic  template generator. Always available. The demo runs on this.
# NOTE before you enable `local`: every AgentSpec.runtime_budget_s is 20s, and a
# 1.5B model on CPU needs minutes. An agent whose run overruns its budget has
# its claims DISCARDED (agents/base.py) — so preferring `local` means raising
# those per-agent budgets first. For the scripted demo, use `deterministic`.
#
# MEASURED on this machine: the local model runs at ~1.6 tokens/second on CPU
# with no GPU. One situation agent took 36.7s. A four-agent assessment is
# therefore ~2.5 minutes — correct, but too slow to stand in front of judges.
# So the DEFAULT is deterministic, and the local model is opt-in:
AURALIS_LLM_BACKEND=deterministic
#
# To use the fine-tuned model instead, swap the line above for:
#   AURALIS_LLM_BACKEND=local,deterministic
# Agent runtime budgets now scale automatically to the local timeout, so a
# completed local run is no longer discarded for overrunning a hosted-model
# budget (see runtime_budget_for() in agents/base.py).
#
# Optional explicit override, seconds. Leave unset to use the derived value.
# AURALIS_AGENT_RUNTIME_BUDGET_S=360

# The fine-tuned model: Qwen2.5-1.5B-Instruct + a PEFT LoRA adapter trained on
# real Andhra Pradesh evidence. NOT copied into the repo — referenced by path.
# Every artifact is sha256-pinned in its artifact_hashes.json and re-verified
# before the weights load; a mismatch refuses to load and logs a security event.
AURALIS_LOCAL_MODEL_DIR=C:\Users\koush\OneDrive\Desktop\final_model

# CPU inference on 1.5B parameters is slow. Bounded output, hard wall-clock
# timeout; on timeout the request is answered from the deterministic path
# instead of hanging. Measured on the reference box: ~22s to load the weights,
# then ~1.6 tokens/second. Re-measure on your hardware and retune both - a
# machine with a GPU wants a far higher token ceiling and a far lower timeout.
AURALIS_LOCAL_MODEL_MAX_NEW_TOKENS=384
AURALIS_LOCAL_MODEL_TIMEOUT_S=300

# Serving NEVER downloads the ~3GB base model — a cold cache means the local
# backend is skipped, not that a request stalls. `scripts/warm_model.py` sets
# this for itself; leave it unset everywhere else.
# AURALIS_LOCAL_MODEL_ALLOW_DOWNLOAD=false
